# /etc/smartrash.env  — copy this file there and chmod 600.
# Shared secret. The ESP32 must send the same value in X-Device-Token.
SMARTRASH_TOKEN=replace-with-a-long-random-string

# Optional tuning. These match the firmware defaults.
SMARTRASH_FULL_CM=10
SMARTRASH_EMPTY_CM=40

# Where the SQLite file lives. Defaults to server/smartrash.db.
# SMARTRASH_DB=/home/kllew/smartrash/server/smartrash.db
